rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function account() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeAccount() {
      return signedIn() && account().status == 'active';
    }

    function hasRole(role) {
      return activeAccount() && account().role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isOwnTeacher(teacherId) {
      return activeAccount()
        && account().role == 'teacher'
        && account().teacherId == teacherId;
    }

    function validPublishedPayslip() {
      return request.resource.data.teacherId is string
        && request.resource.data.teacherUid is string
        && request.resource.data.month is string
        && request.resource.data.status == 'published'
        && request.resource.data.revision is int
        && request.resource.data.revision >= 1;
    }

    function excludesResidentRegistrationNumber(data) {
      return !data.keys().hasAny([
        'residentRegistrationNumber', 'residentNumber', 'rrn', 'socialSecurityNumber'
      ]);
    }

    function hasValidTeacherIdentity(data) {
      return data.birthDateCode is string
        && data.birthDateCode.matches('^[0-9]{6}$')
        && data.genderCode is string
        && data.genderCode.matches('^[1-8]$');
    }

    function hasMissingTeacherIdentity(data) {
      return !data.keys().hasAny(['birthDateCode', 'genderCode']);
    }

    function hasValidOrMissingTeacherIdentity(data) {
      return hasValidTeacherIdentity(data) || hasMissingTeacherIdentity(data);
    }

    function preservesLegacyTeacherIdentity(data) {
      return !resource.data.keys().hasAny(['birthDateCode', 'genderCode'])
        && !data.keys().hasAny(['birthDateCode', 'genderCode']);
    }

    function hasValidIncomeComposition(data) {
      return data.incomeComposition is string
        && data.incomeComposition in ['employee', 'business', 'mixed'];
    }

    function validSelfInsuranceItem(item) {
      return item is map
        && item.keys().hasOnly(['enrolled', 'defaultBaseAmount', 'effectiveFrom', 'effectiveTo'])
        && item.keys().hasAll(['enrolled', 'defaultBaseAmount', 'effectiveFrom', 'effectiveTo'])
        && item.enrolled is bool;
    }

    function hasValidSelfInsuranceSettings(data) {
      return data.insuranceSettings is map
        && data.insuranceSettings.keys().hasOnly([
          'nationalPension', 'healthInsurance', 'employmentInsurance'
        ])
        && data.insuranceSettings.keys().hasAll([
          'nationalPension', 'healthInsurance', 'employmentInsurance'
        ])
        && validSelfInsuranceItem(data.insuranceSettings.nationalPension)
        && validSelfInsuranceItem(data.insuranceSettings.healthInsurance)
        && validSelfInsuranceItem(data.insuranceSettings.employmentInsurance)
        && data.insuranceEnrolled is bool
        && data.insuranceEnrolled == (
          data.insuranceSettings.nationalPension.enrolled
          || data.insuranceSettings.healthInsurance.enrolled
          || data.insuranceSettings.employmentInsurance.enrolled
        );
    }

    function preservesInsuranceAdministrationFields(data) {
      return (!resource.data.keys().hasAny(['insuranceSettings'])
          && data.insuranceSettings.nationalPension.defaultBaseAmount == null
          && data.insuranceSettings.nationalPension.effectiveFrom == null
          && data.insuranceSettings.nationalPension.effectiveTo == null
          && data.insuranceSettings.healthInsurance.defaultBaseAmount == null
          && data.insuranceSettings.healthInsurance.effectiveFrom == null
          && data.insuranceSettings.healthInsurance.effectiveTo == null
          && data.insuranceSettings.employmentInsurance.defaultBaseAmount == null
          && data.insuranceSettings.employmentInsurance.effectiveFrom == null
          && data.insuranceSettings.employmentInsurance.effectiveTo == null)
        || (resource.data.keys().hasAny(['insuranceSettings'])
          && data.insuranceSettings.nationalPension.defaultBaseAmount == resource.data.insuranceSettings.nationalPension.defaultBaseAmount
          && data.insuranceSettings.nationalPension.effectiveFrom == resource.data.insuranceSettings.nationalPension.effectiveFrom
          && data.insuranceSettings.nationalPension.effectiveTo == resource.data.insuranceSettings.nationalPension.effectiveTo
          && data.insuranceSettings.healthInsurance.defaultBaseAmount == resource.data.insuranceSettings.healthInsurance.defaultBaseAmount
          && data.insuranceSettings.healthInsurance.effectiveFrom == resource.data.insuranceSettings.healthInsurance.effectiveFrom
          && data.insuranceSettings.healthInsurance.effectiveTo == resource.data.insuranceSettings.healthInsurance.effectiveTo
          && data.insuranceSettings.employmentInsurance.defaultBaseAmount == resource.data.insuranceSettings.employmentInsurance.defaultBaseAmount
          && data.insuranceSettings.employmentInsurance.effectiveFrom == resource.data.insuranceSettings.employmentInsurance.effectiveFrom
          && data.insuranceSettings.employmentInsurance.effectiveTo == resource.data.insuranceSettings.employmentInsurance.effectiveTo);
    }

    function validBusinessRateAt(rates, index) {
      return rates.size() <= index ? true : (
        rates[index] is map
        && rates[index].keys().hasOnly(['id', 'subjectName', 'hourlyRate'])
        && rates[index].keys().hasAll(['id', 'subjectName', 'hourlyRate'])
        && rates[index].id is string
        && rates[index].id.size() > 0
        && rates[index].id.size() <= 100
        && rates[index].subjectName is string
        && rates[index].subjectName.size() > 0
        && rates[index].subjectName.size() <= 50
        && rates[index].hourlyRate is number
        && rates[index].hourlyRate > 0
        && rates[index].hourlyRate <= 10000000
      );
    }

    function hasValidSelfBusinessRates(data) {
      return data.defaultBusinessHourlyRate is number
        && data.defaultBusinessHourlyRate >= 0
        && data.defaultBusinessHourlyRate <= 10000000
        && data.usesSubjectRates is bool
        && data.businessRates is list
        && data.businessRates.size() <= 10
        && data.subjects is list
        && data.subjects.size() <= 10
        && validBusinessRateAt(data.businessRates, 0)
        && validBusinessRateAt(data.businessRates, 1)
        && validBusinessRateAt(data.businessRates, 2)
        && validBusinessRateAt(data.businessRates, 3)
        && validBusinessRateAt(data.businessRates, 4)
        && validBusinessRateAt(data.businessRates, 5)
        && validBusinessRateAt(data.businessRates, 6)
        && validBusinessRateAt(data.businessRates, 7)
        && validBusinessRateAt(data.businessRates, 8)
        && validBusinessRateAt(data.businessRates, 9)
        && (data.usesSubjectRates
          ? data.defaultBusinessHourlyRate == 0
            && data.businessRates.size() >= 2
            && data.subjects.size() == data.businessRates.size()
          : data.businessRates.size() == 0
            && data.subjects.size() == 0);
    }

    function hasValidSelfIncomeComposition(data) {
      return data.insuranceEnrolled
        ? ((data.defaultBusinessHourlyRate > 0 || data.businessRates.size() > 0)
          ? data.incomeComposition == 'mixed' && data.contractSummary == '근로소득 + 사업소득'
          : data.incomeComposition == 'employee' && data.contractSummary == '근로소득')
        : data.incomeComposition == 'business'
          && data.contractSummary == '사업소득'
          && (data.defaultBusinessHourlyRate > 0 || data.businessRates.size() > 0);
    }

    function preservesLegacyIncomeComposition(data) {
      return !resource.data.keys().hasAny(['incomeComposition'])
        && !data.keys().hasAny(['incomeComposition']);
    }

    function doesNotAddAccountingReference(data) {
      return !data.keys().hasAny(['accountingReference'])
        || (resource.data.keys().hasAny(['accountingReference'])
          && data.accountingReference == resource.data.accountingReference);
    }

    function monthIsEditable(month) {
      return !exists(/databases/$(database)/documents/payrollRuns/$(month))
        || get(/databases/$(database)/documents/payrollRuns/$(month)).data.status != 'published';
    }

    function validTeacherWorkHoursNotification(notificationId) {
      return activeAccount()
        && account().role == 'teacher'
        && notificationId == 'work-hours_' + request.resource.data.month + '_' + account().teacherId
        && request.resource.data.keys().hasOnly([
          'type', 'teacherId', 'teacherUid', 'month', 'status',
          'submittedAt', 'readAt', 'readBy'
        ])
        && request.resource.data.type == 'teacher_monthly_input_submitted'
        && request.resource.data.teacherId == account().teacherId
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.month.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.status == 'unread'
        && request.resource.data.submittedAt == request.time
        && request.resource.data.readAt == null
        && request.resource.data.readBy == null
        && existsAfter(/databases/$(database)/documents/teacherMonthlyInputs/$(request.resource.data.month + '_' + account().teacherId))
        && getAfter(/databases/$(database)/documents/teacherMonthlyInputs/$(request.resource.data.month + '_' + account().teacherId)).data.updatedAt == request.time
        && monthIsEditable(request.resource.data.month);
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (request.auth.uid == uid
          && hasRole('teacher')
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName', 'updatedAt', 'updatedBy'
          ]));
    }

    match /accessRequests/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'status', 'requestedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedAt == request.time;
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && (
          (request.resource.data.status == 'approved'
            && request.resource.data.teacherId is string
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'teacherId', 'reviewedAt', 'reviewedBy'
            ]))
          || (request.resource.data.status == 'rejected'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'reviewedAt', 'reviewedBy'
            ]))
        );
      allow delete: if false;
    }

    match /teachers/{teacherId} {
      allow get: if isAdmin() || isOwnTeacher(teacherId);
      allow list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.status in ['active', 'inactive']
        && hasValidIncomeComposition(request.resource.data)
        && hasValidOrMissingTeacherIdentity(request.resource.data)
        && !request.resource.data.keys().hasAny(['accountingReference'])
        && excludesResidentRegistrationNumber(request.resource.data);
      allow update: if (isAdmin()
          && request.resource.data.name is string
          && request.resource.data.status in ['active', 'inactive']
          && (hasValidIncomeComposition(request.resource.data)
            || preservesLegacyIncomeComposition(request.resource.data))
          && (hasValidTeacherIdentity(request.resource.data)
            || preservesLegacyTeacherIdentity(request.resource.data))
          && doesNotAddAccountingReference(request.resource.data)
          && excludesResidentRegistrationNumber(request.resource.data))
        || (isOwnTeacher(teacherId)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.phone is string
          && hasValidTeacherIdentity(request.resource.data)
          && hasValidSelfInsuranceSettings(request.resource.data)
          && preservesInsuranceAdministrationFields(request.resource.data)
          && hasValidSelfBusinessRates(request.resource.data)
          && hasValidSelfIncomeComposition(request.resource.data)
          && request.resource.data.profileCompleted == true
          && excludesResidentRegistrationNumber(request.resource.data)
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'phone', 'birthDateCode', 'genderCode', 'subjects',
            'incomeComposition', 'contractSummary', 'insuranceEnrolled', 'insuranceSettings',
            'defaultBusinessHourlyRate', 'usesSubjectRates', 'businessRates', 'profileCompleted',
            'updatedAt', 'updatedBy'
          ]));
      allow delete: if false;
    }

    match /teacherMonthlyInputs/{inputId} {
      allow read: if isAdmin()
        || (activeAccount()
          && account().role == 'teacher'
          && resource.data.teacherUid == request.auth.uid
          && resource.data.teacherId == account().teacherId);
      allow create, update: if isAdmin()
        || (activeAccount()
          && account().role == 'teacher'
          && inputId == request.resource.data.month + '_' + account().teacherId
          && request.resource.data.keys().hasOnly([
            'teacherId', 'teacherUid', 'month', 'employeeWorkHours',
            'businessHours', 'submittedAt', 'updatedAt', 'updatedBy'
          ])
          && request.resource.data.teacherId == account().teacherId
          && request.resource.data.teacherUid == request.auth.uid
          && request.resource.data.month.matches('^[0-9]{4}-[0-9]{2}$')
          && request.resource.data.employeeWorkHours is number
          && request.resource.data.employeeWorkHours >= 0
          && request.resource.data.employeeWorkHours <= 744
          && request.resource.data.businessHours is map
          && request.resource.data.submittedAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid
          && monthIsEditable(request.resource.data.month));
      allow delete: if false;
    }

    match /adminNotifications/{notificationId} {
      allow read: if isAdmin();
      allow create: if validTeacherWorkHoursNotification(notificationId);
      allow update: if validTeacherWorkHoursNotification(notificationId)
        || (isAdmin()
          && resource.data.type == 'teacher_monthly_input_submitted'
          && resource.data.status == 'unread'
          && request.resource.data.status == 'read'
          && request.resource.data.readAt == request.time
          && request.resource.data.readBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'readAt', 'readBy'
          ]));
      allow delete: if false;
    }

    match /rateRules/{ruleId} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    match /workEntries/{entryId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && (!exists(/databases/$(database)/documents/payrollRuns/$(request.resource.data.month))
          || get(/databases/$(database)/documents/payrollRuns/$(request.resource.data.month)).data.status != 'published');
      allow update: if isAdmin()
        && (!exists(/databases/$(database)/documents/payrollRuns/$(resource.data.month))
          || get(/databases/$(database)/documents/payrollRuns/$(resource.data.month)).data.status != 'published')
        && (!exists(/databases/$(database)/documents/payrollRuns/$(request.resource.data.month))
          || get(/databases/$(database)/documents/payrollRuns/$(request.resource.data.month)).data.status != 'published');
      allow delete: if isAdmin()
        && !exists(/databases/$(database)/documents/payrollRuns/$(resource.data.month))
        || (isAdmin()
          && get(/databases/$(database)/documents/payrollRuns/$(resource.data.month)).data.status != 'published');
    }

    match /payrollPolicies/{policyId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /taxPolicies/{policyId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.version == policyId
        && request.resource.data.effectiveFrom is string
        && request.resource.data.status == 'published';
      allow update, delete: if false;
    }

    match /insurancePolicies/{policyId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.version == policyId
        && request.resource.data.effectiveFrom is string;
      allow update, delete: if false;
    }

    match /payrollOverrides/{overrideId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && excludesResidentRegistrationNumber(request.resource.data);
      allow delete: if false;
    }

    match /payrollRuns/{month} {
      allow read: if isAdmin() || hasRole('teacher');
      allow create: if isAdmin()
        && request.resource.data.status in ['draft', 'ready', 'published']
        && (request.resource.data.status != 'published'
          || (request.resource.data.revision is int && request.resource.data.revision == 1));
      allow update: if isAdmin()
        && (
          (resource.data.status in ['draft', 'ready']
            && request.resource.data.status in ['draft', 'ready', 'published'])
          || (resource.data.status == 'published'
            && request.resource.data.status == 'cancelled'
            && request.resource.data.revision == resource.data.get('revision', 1)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'revision', 'cancellationId', 'cancellationReason',
              'cancelledAt', 'updatedAt', 'updatedBy'
            ]))
          || (resource.data.status == 'cancelled'
            && request.resource.data.status == 'published'
            && request.resource.data.revision is int
            && request.resource.data.revision == resource.data.revision + 1)
        );
      allow delete: if false;
    }

    match /payslips/{payslipId} {
      allow get, list: if isAdmin()
        || (activeAccount()
          && account().role == 'teacher'
          && resource.data.teacherUid == request.auth.uid
          && resource.data.status == 'published');
      allow create: if isAdmin() && validPublishedPayslip();
      allow update: if isAdmin()
        && (
          (resource.data.status == 'published'
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'cancellationId', 'cancellationReason', 'cancelledAt',
              'updatedAt', 'updatedBy'
            ]))
          || (resource.data.status == 'cancelled'
            && validPublishedPayslip()
            && request.resource.data.revision == resource.data.get('revision', 1) + 1)
        );
      allow delete: if false;
    }

    match /payslipVersions/{versionId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validPublishedPayslip();
      allow update, delete: if false;
    }

    match /payrollCancellations/{cancellationId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.month is string
        && request.resource.data.revision is int
        && request.resource.data.revision >= 1
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 5
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /payslipReceipts/{receiptId} {
      allow get: if isAdmin()
        || (activeAccount()
          && account().role == 'teacher'
          && receiptId.matches('.*_' + request.auth.uid));
      allow list: if isAdmin()
        || (activeAccount()
          && account().role == 'teacher'
          && resource.data.teacherUid == request.auth.uid);
      allow create: if activeAccount()
        && account().role == 'teacher'
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.teacherId == account().teacherId
        && request.resource.data.revision is int
        && request.resource.data.viewedAt == request.time
        && request.resource.data.keys().hasOnly([
          'payslipId', 'teacherId', 'teacherUid', 'month', 'revision', 'viewedAt'
        ])
        && get(/databases/$(database)/documents/payslips/$(request.resource.data.payslipId)).data.teacherUid == request.auth.uid
        && get(/databases/$(database)/documents/payslips/$(request.resource.data.payslipId)).data.teacherId == request.resource.data.teacherId
        && get(/databases/$(database)/documents/payslips/$(request.resource.data.payslipId)).data.month == request.resource.data.month
        && get(/databases/$(database)/documents/payslips/$(request.resource.data.payslipId)).data.revision == request.resource.data.revision
        && get(/databases/$(database)/documents/payslips/$(request.resource.data.payslipId)).data.status == 'published';
      allow update, delete: if false;
    }

    match /payslipDeliveries/{deliveryId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'payslipId', 'teacherId', 'month', 'recipientEmail', 'channel',
          'gmailMessageId', 'revision', 'sentBy', 'sentAt'
        ])
        && request.resource.data.payslipId is string
        && request.resource.data.teacherId is string
        && request.resource.data.month is string
        && request.resource.data.revision is int
        && request.resource.data.recipientEmail is string
        && request.resource.data.channel == 'gmail_attachment'
        && request.resource.data.gmailMessageId is string
        && request.resource.data.sentBy == request.auth.uid
        && request.resource.data.sentAt == request.time
        && get(/databases/$(database)/documents/payslips/$(request.resource.data.payslipId)).data.teacherId == request.resource.data.teacherId
        && get(/databases/$(database)/documents/payslips/$(request.resource.data.payslipId)).data.month == request.resource.data.month
        && get(/databases/$(database)/documents/payslips/$(request.resource.data.payslipId)).data.revision == request.resource.data.revision
        && get(/databases/$(database)/documents/payslips/$(request.resource.data.payslipId)).data.status == 'published';
      allow update, delete: if false;
    }

    match /payrollLedgers/{ledgerId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
