rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function account() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeAccount() {
      return signedIn() && account().status == 'active';
    }

    function hasRole(role) {
      return activeAccount() && account().role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isOwnTeacher(teacherId) {
      return activeAccount()
        && account().role == 'teacher'
        && account().teacherId == teacherId;
    }

    function validPublishedPayslip() {
      return request.resource.data.teacherId is string
        && request.resource.data.teacherUid is string
        && request.resource.data.month is string
        && request.resource.data.status == 'published'
        && request.resource.data.revision is int
        && request.resource.data.revision >= 1;
    }

    function excludesResidentRegistrationNumber(data) {
      return !data.keys().hasAny([
        'residentRegistrationNumber', 'residentNumber', 'rrn', 'socialSecurityNumber'
      ]);
    }

    function hasValidTeacherIdentity(data) {
      return data.birthDateCode is string
        && data.birthDateCode.matches('^[0-9]{6}$')
        && data.genderCode is string
        && data.genderCode.matches('^[1-8]$');
    }

    function hasMissingTeacherIdentity(data) {
      return !data.keys().hasAny(['birthDateCode', 'genderCode']);
    }

    function hasValidOrMissingTeacherIdentity(data) {
      return hasValidTeacherIdentity(data) || hasMissingTeacherIdentity(data);
    }

    function hasValidIncomeComposition(data) {
      return data.incomeComposition is string
        && data.incomeComposition in ['employee', 'business', 'mixed'];
    }

    function validInsuranceItem(item) {
      return item is map
        && item.keys().hasOnly(['enrolled', 'defaultBaseAmount', 'effectiveFrom', 'effectiveTo'])
        && item.keys().hasAll(['enrolled', 'defaultBaseAmount', 'effectiveFrom', 'effectiveTo'])
        && item.enrolled is bool
        && (item.defaultBaseAmount == null
          || (item.defaultBaseAmount is number
            && item.defaultBaseAmount >= 0
            && item.defaultBaseAmount <= 100000000))
        && (item.effectiveFrom == null || item.effectiveFrom is string)
        && (item.effectiveTo == null || item.effectiveTo is string);
    }

    function hasValidInsuranceSettings(data) {
      return data.insuranceSettings is map
        && data.insuranceSettings.keys().hasOnly([
          'nationalPension', 'healthInsurance', 'employmentInsurance'
        ])
        && data.insuranceSettings.keys().hasAll([
          'nationalPension', 'healthInsurance', 'employmentInsurance'
        ])
        && validInsuranceItem(data.insuranceSettings.nationalPension)
        && validInsuranceItem(data.insuranceSettings.healthInsurance)
        && validInsuranceItem(data.insuranceSettings.employmentInsurance);
    }

    function hasAnyInsurance(data) {
      return data.insuranceSettings.nationalPension.enrolled
        || data.insuranceSettings.healthInsurance.enrolled
        || data.insuranceSettings.employmentInsurance.enrolled;
    }

    function preservesInsuranceAdministrationFields(data) {
      return (!resource.data.keys().hasAny(['insuranceSettings'])
          && data.insuranceSettings.nationalPension.defaultBaseAmount == null
          && data.insuranceSettings.nationalPension.effectiveFrom == null
          && data.insuranceSettings.nationalPension.effectiveTo == null
          && data.insuranceSettings.healthInsurance.defaultBaseAmount == null
          && data.insuranceSettings.healthInsurance.effectiveFrom == null
          && data.insuranceSettings.healthInsurance.effectiveTo == null
          && data.insuranceSettings.employmentInsurance.defaultBaseAmount == null
          && data.insuranceSettings.employmentInsurance.effectiveFrom == null
          && data.insuranceSettings.employmentInsurance.effectiveTo == null)
        || (resource.data.keys().hasAny(['insuranceSettings'])
          && data.insuranceSettings.nationalPension.defaultBaseAmount == resource.data.insuranceSettings.nationalPension.defaultBaseAmount
          && data.insuranceSettings.nationalPension.effectiveFrom == resource.data.insuranceSettings.nationalPension.effectiveFrom
          && data.insuranceSettings.nationalPension.effectiveTo == resource.data.insuranceSettings.nationalPension.effectiveTo
          && data.insuranceSettings.healthInsurance.defaultBaseAmount == resource.data.insuranceSettings.healthInsurance.defaultBaseAmount
          && data.insuranceSettings.healthInsurance.effectiveFrom == resource.data.insuranceSettings.healthInsurance.effectiveFrom
          && data.insuranceSettings.healthInsurance.effectiveTo == resource.data.insuranceSettings.healthInsurance.effectiveTo
          && data.insuranceSettings.employmentInsurance.defaultBaseAmount == resource.data.insuranceSettings.employmentInsurance.defaultBaseAmount
          && data.insuranceSettings.employmentInsurance.effectiveFrom == resource.data.insuranceSettings.employmentInsurance.effectiveFrom
          && data.insuranceSettings.employmentInsurance.effectiveTo == resource.data.insuranceSettings.employmentInsurance.effectiveTo);
    }

    function validBusinessRateAt(rates, index) {
      return rates.size() <= index ? true : (
        rates[index] is map
        && rates[index].keys().hasAll(['id'])
        && rates[index].id is string
        && rates[index].id.size() > 0
        && rates[index].id.size() <= 100
        && ((rates[index].keys().hasOnly(['id', 'hourlyRate'])
          && rates[index].keys().hasAll(['hourlyRate'])
          && rates[index].hourlyRate is number
          && rates[index].hourlyRate > 0
          && rates[index].hourlyRate <= 10000000)
        || (rates[index].keys().hasOnly(['id', 'tuitionShareRate'])
          && rates[index].keys().hasAll(['tuitionShareRate'])
          && rates[index].tuitionShareRate is number
          && rates[index].tuitionShareRate > 0
          && rates[index].tuitionShareRate <= 100
          && math.abs(rates[index].tuitionShareRate * 100 - math.round(rates[index].tuitionShareRate * 100)) <= 0.000001))
      );
    }

    function tuitionShareCountAt(rates, index) {
      return rates.size() <= index ? 0 : (rates[index].keys().hasAny(['tuitionShareRate']) ? 1 : 0);
    }

    function hasValidBusinessRates(data) {
      return data.businessRates is list
        && data.businessRates.size() <= 10
        && validBusinessRateAt(data.businessRates, 0)
        && validBusinessRateAt(data.businessRates, 1)
        && validBusinessRateAt(data.businessRates, 2)
        && validBusinessRateAt(data.businessRates, 3)
        && validBusinessRateAt(data.businessRates, 4)
        && validBusinessRateAt(data.businessRates, 5)
        && validBusinessRateAt(data.businessRates, 6)
        && validBusinessRateAt(data.businessRates, 7)
        && validBusinessRateAt(data.businessRates, 8)
        && validBusinessRateAt(data.businessRates, 9)
        && tuitionShareCountAt(data.businessRates, 0)
          + tuitionShareCountAt(data.businessRates, 1)
          + tuitionShareCountAt(data.businessRates, 2)
          + tuitionShareCountAt(data.businessRates, 3)
          + tuitionShareCountAt(data.businessRates, 4)
          + tuitionShareCountAt(data.businessRates, 5)
          + tuitionShareCountAt(data.businessRates, 6)
          + tuitionShareCountAt(data.businessRates, 7)
          + tuitionShareCountAt(data.businessRates, 8)
          + tuitionShareCountAt(data.businessRates, 9) <= 1;
    }

    function hasValidSelfIncomeComposition(data) {
      return hasAnyInsurance(data)
        ? (data.businessRates.size() > 0
          ? data.incomeComposition == 'mixed'
          : data.incomeComposition == 'employee')
        : data.incomeComposition == 'business'
          && data.businessRates.size() > 0;
    }

    function hasValidTransportPolicy(data) {
      return data.transportPolicy is map
        && data.transportPolicy.keys().hasOnly(['regionLabel', 'unitAmount', 'treatment'])
        && data.transportPolicy.keys().hasAll(['regionLabel', 'unitAmount', 'treatment'])
        && data.transportPolicy.regionLabel is string
        && data.transportPolicy.regionLabel.size() <= 100
        && data.transportPolicy.unitAmount is number
        && data.transportPolicy.unitAmount >= 0
        && data.transportPolicy.unitAmount <= 1000000
        && data.transportPolicy.treatment in ['employee', 'business', 'other', 'exempt', 'pending'];
    }

    function hasValidTaxProfile(data) {
      return data.taxProfile is map
        && data.taxProfile.keys().hasOnly(['dependentCount', 'children8To20', 'withholdingRatio'])
        && data.taxProfile.keys().hasAll(['dependentCount', 'children8To20', 'withholdingRatio'])
        && data.taxProfile.dependentCount is int
        && data.taxProfile.dependentCount >= 1
        && data.taxProfile.dependentCount <= 99
        && data.taxProfile.children8To20 is int
        && data.taxProfile.children8To20 >= 0
        && data.taxProfile.children8To20 <= 99
        && data.taxProfile.withholdingRatio in [0.8, 1, 1.2];
    }

    function hasConsistentIncomeComposition(data) {
      return (data.incomeComposition == 'employee'
          && data.businessRates.size() == 0)
        || (data.incomeComposition == 'business'
          && data.defaultEmployeePay == 0
          && !hasAnyInsurance(data)
          && (data.businessRates.size() > 0 || data.profileCompleted == false))
        || (data.incomeComposition == 'mixed'
          && data.businessRates.size() > 0);
    }

    function hasValidPhoneNumber(phone) {
      return phone is string
        && phone.size() <= 11
        && (phone == ''
          || phone.matches('^010[0-9]{8}$'));
    }

    function hasValidPersonName(name) {
      return name is string
        && name.size() > 0
        && name.size() <= 100
        && name.matches('^[A-Za-z가-힣]+( [A-Za-z가-힣]+)*$');
    }

    function hasValidTeacherDocument(data, teacherId) {
      return data.keys().hasOnly([
          'id', 'name', 'email', 'phone', 'birthDateCode', 'genderCode',
          'status', 'authUid', 'profileCompleted', 'incomeComposition',
          'insuranceSettings', 'defaultEmployeePay', 'businessRates',
          'transportPolicy', 'paymentDay', 'taxProfile', 'updatedAt', 'updatedBy'
        ])
        && data.id == teacherId
        && hasValidPersonName(data.name)
        && data.email is string
        && data.email.size() > 3
        && data.email.size() <= 320
        && hasValidPhoneNumber(data.phone)
        && data.status in ['active', 'inactive']
        && (data.authUid == null || data.authUid is string)
        && data.profileCompleted is bool
        && hasValidIncomeComposition(data)
        && hasValidOrMissingTeacherIdentity(data)
        && hasValidInsuranceSettings(data)
        && data.defaultEmployeePay is number
        && data.defaultEmployeePay >= 0
        && data.defaultEmployeePay <= 100000000
        && hasValidBusinessRates(data)
        && hasConsistentIncomeComposition(data)
        && hasValidTransportPolicy(data)
        && data.paymentDay is int
        && data.paymentDay >= 1
        && data.paymentDay <= 31
        && hasValidTaxProfile(data)
        && !data.keys().hasAny(['accountingReference'])
        && excludesResidentRegistrationNumber(data);
    }

    function monthIsEditable(month) {
      return !exists(/databases/$(database)/documents/payrollRuns/$(month))
        || get(/databases/$(database)/documents/payrollRuns/$(month)).data.status != 'published';
    }

    function monthHasNoApprovedPayroll(month) {
      return !exists(/databases/$(database)/documents/payrollRuns/$(month))
        || get(/databases/$(database)/documents/payrollRuns/$(month)).data.status in ['draft', 'ready'];
    }

    function validTeacherWorkHoursNotification(notificationId) {
      return activeAccount()
        && account().role == 'teacher'
        && notificationId == 'work-hours_' + request.resource.data.month + '_' + account().teacherId
        && request.resource.data.keys().hasOnly([
          'type', 'teacherId', 'teacherUid', 'month', 'status',
          'submittedAt', 'readAt', 'readBy'
        ])
        && request.resource.data.type == 'teacher_monthly_input_submitted'
        && request.resource.data.teacherId == account().teacherId
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.month.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.status == 'unread'
        && request.resource.data.submittedAt == request.time
        && request.resource.data.readAt == null
        && request.resource.data.readBy == null
        && existsAfter(/databases/$(database)/documents/teacherMonthlyInputs/$(request.resource.data.month + '_' + account().teacherId))
        && getAfter(/databases/$(database)/documents/teacherMonthlyInputs/$(request.resource.data.month + '_' + account().teacherId)).data.updatedAt == request.time
        && monthIsEditable(request.resource.data.month);
    }

    function hasValidExpenseReceipt(data, receiptId) {
      return data.keys().hasOnly([
          'id', 'teacherId', 'teacherUid', 'month', 'expenseDate', 'category', 'amount', 'note',
          'status', 'treatment', 'insuranceCovered', 'fileId', 'fileName', 'mimeType', 'sizeBytes',
          'sha256', 'submittedAt', 'reviewedAt', 'reviewedBy', 'reviewNote', 'updatedAt', 'updatedBy'
        ])
        && data.keys().hasAll([
          'id', 'teacherId', 'teacherUid', 'month', 'expenseDate', 'category', 'amount', 'note',
          'status', 'treatment', 'insuranceCovered', 'fileId', 'fileName', 'mimeType', 'sizeBytes',
          'sha256', 'submittedAt', 'reviewedAt', 'reviewedBy', 'reviewNote', 'updatedAt', 'updatedBy'
        ])
        && data.id == receiptId
        && data.teacherId is string
        && data.teacherUid is string
        && data.month.matches('^[0-9]{4}-[0-9]{2}$')
        && data.expenseDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.expenseDate.matches('^' + data.month + '-[0-9]{2}$')
        && data.category in ['transport', 'parking']
        && data.amount is int
        && data.amount > 0
        && data.amount <= 10000000
        && data.note is string
        && data.note.size() <= 200
        && data.status in ['pending', 'approved', 'rejected']
        && data.treatment in ['employee', 'business', 'other', 'exempt', 'pending']
        && data.insuranceCovered is bool
        && data.fileId is string
        && data.fileId.size() > 0
        && data.fileId.size() <= 200
        && data.fileName is string
        && data.fileName.size() > 0
        && data.fileName.size() <= 240
        && data.mimeType in ['image/jpeg', 'image/png', 'image/webp', 'application/pdf']
        && data.sizeBytes is int
        && data.sizeBytes > 0
        && data.sizeBytes <= 5242880
        && data.sha256 is string
        && data.sha256.matches('^[0-9a-f]{64}$')
        && data.reviewNote is string
        && data.reviewNote.size() <= 200;
    }

    function validTeacherExpenseReceiptNotification(notificationId) {
      return activeAccount()
        && account().role == 'teacher'
        && notificationId == 'expense-receipt_' + request.resource.data.receiptId
        && request.resource.data.keys().hasOnly([
          'type', 'receiptId', 'teacherId', 'teacherUid', 'month', 'category', 'amount',
          'status', 'submittedAt', 'readAt', 'readBy'
        ])
        && request.resource.data.type == 'expense_receipt_submitted'
        && request.resource.data.teacherId == account().teacherId
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.month.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.category in ['transport', 'parking']
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.status == 'unread'
        && request.resource.data.submittedAt == request.time
        && request.resource.data.readAt == null
        && request.resource.data.readBy == null
        && existsAfter(/databases/$(database)/documents/expenseReceipts/$(request.resource.data.receiptId))
        && getAfter(/databases/$(database)/documents/expenseReceipts/$(request.resource.data.receiptId)).data.updatedAt == request.time
        && monthIsEditable(request.resource.data.month);
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (request.auth.uid == uid
          && hasRole('teacher')
          && hasValidPersonName(request.resource.data.displayName)
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName', 'updatedAt', 'updatedBy'
          ]));
    }

    match /accessRequests/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'status', 'requestedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedAt == request.time;
      allow update: if (isAdmin()
          && resource.data.status == 'pending'
          && request.resource.data.reviewedBy == request.auth.uid
          && request.resource.data.reviewedAt == request.time
          && (
            (request.resource.data.status == 'approved'
              && request.resource.data.teacherId is string
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status', 'teacherId', 'reviewedAt', 'reviewedBy'
              ]))
            || (request.resource.data.status == 'rejected'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status', 'reviewedAt', 'reviewedBy'
              ]))
          ))
        || (signedIn()
          && request.auth.uid == uid
          && resource.data.status == 'rejected'
          && request.resource.data.keys().hasOnly([
            'uid', 'email', 'displayName', 'status', 'requestedAt'
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.displayName is string
          && request.resource.data.status == 'pending'
          && request.resource.data.requestedAt == request.time);
      allow delete: if isAdmin();
    }

    match /teachers/{teacherId} {
      allow get: if isAdmin() || isOwnTeacher(teacherId);
      allow list: if isAdmin();
      allow create: if isAdmin()
        && hasValidTeacherDocument(request.resource.data, teacherId);
      allow update: if (isAdmin()
          && hasValidTeacherDocument(request.resource.data, teacherId))
        || (isOwnTeacher(teacherId)
          && hasValidPersonName(request.resource.data.name)
          && hasValidPhoneNumber(request.resource.data.phone)
          && hasValidTeacherIdentity(request.resource.data)
          && hasValidInsuranceSettings(request.resource.data)
          && preservesInsuranceAdministrationFields(request.resource.data)
          && hasValidBusinessRates(request.resource.data)
          && hasValidSelfIncomeComposition(request.resource.data)
          && request.resource.data.profileCompleted == true
          && excludesResidentRegistrationNumber(request.resource.data)
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'phone', 'birthDateCode', 'genderCode',
            'incomeComposition', 'insuranceSettings', 'businessRates', 'profileCompleted',
            'updatedAt', 'updatedBy'
          ]));
      allow delete: if isAdmin();
    }

    function validTuitionGroupAt(groups, index) {
      return groups.size() <= index ? true : (
        groups[index] is map
        && groups[index].keys().hasOnly(['studentCount', 'tuitionPerStudent'])
        && groups[index].keys().hasAll(['studentCount', 'tuitionPerStudent'])
        && groups[index].studentCount is int
        && groups[index].studentCount >= 0
        && groups[index].studentCount <= 1000
        && groups[index].tuitionPerStudent is int
        && groups[index].tuitionPerStudent >= 0
        && groups[index].tuitionPerStudent <= 10000000
      );
    }

    function tuitionGroupAmountAt(groups, index) {
      return groups.size() <= index ? 0 : groups[index].studentCount * groups[index].tuitionPerStudent;
    }

    function matchesTuitionRateAt(rates, rateId, index) {
      return rates.size() > index
        && rates[index].keys().hasAny(['tuitionShareRate'])
        && rates[index].id == rateId;
    }

    function ownsTuitionRate(teacherId, rateId) {
      let rates = get(/databases/$(database)/documents/teachers/$(teacherId)).data.businessRates;
      return matchesTuitionRateAt(rates, rateId, 0)
        || matchesTuitionRateAt(rates, rateId, 1)
        || matchesTuitionRateAt(rates, rateId, 2)
        || matchesTuitionRateAt(rates, rateId, 3)
        || matchesTuitionRateAt(rates, rateId, 4)
        || matchesTuitionRateAt(rates, rateId, 5)
        || matchesTuitionRateAt(rates, rateId, 6)
        || matchesTuitionRateAt(rates, rateId, 7)
        || matchesTuitionRateAt(rates, rateId, 8)
        || matchesTuitionRateAt(rates, rateId, 9);
    }

    function hasValidTuitionSubmission(data) {
      return !data.keys().hasAny(['tuitionInput']) || data.tuitionInput == null || (
        data.tuitionInput is map
        && data.tuitionInput.keys().hasOnly(['rateId', 'groups'])
        && data.tuitionInput.keys().hasAll(['rateId', 'groups'])
        && data.tuitionInput.rateId is string
        && ownsTuitionRate(data.teacherId, data.tuitionInput.rateId)
        && data.tuitionInput.groups is list
        && data.tuitionInput.groups.size() <= 10
        && validTuitionGroupAt(data.tuitionInput.groups, 0)
        && validTuitionGroupAt(data.tuitionInput.groups, 1)
        && validTuitionGroupAt(data.tuitionInput.groups, 2)
        && validTuitionGroupAt(data.tuitionInput.groups, 3)
        && validTuitionGroupAt(data.tuitionInput.groups, 4)
        && validTuitionGroupAt(data.tuitionInput.groups, 5)
        && validTuitionGroupAt(data.tuitionInput.groups, 6)
        && validTuitionGroupAt(data.tuitionInput.groups, 7)
        && validTuitionGroupAt(data.tuitionInput.groups, 8)
        && validTuitionGroupAt(data.tuitionInput.groups, 9)
        && tuitionGroupAmountAt(data.tuitionInput.groups, 0)
          + tuitionGroupAmountAt(data.tuitionInput.groups, 1)
          + tuitionGroupAmountAt(data.tuitionInput.groups, 2)
          + tuitionGroupAmountAt(data.tuitionInput.groups, 3)
          + tuitionGroupAmountAt(data.tuitionInput.groups, 4)
          + tuitionGroupAmountAt(data.tuitionInput.groups, 5)
          + tuitionGroupAmountAt(data.tuitionInput.groups, 6)
          + tuitionGroupAmountAt(data.tuitionInput.groups, 7)
          + tuitionGroupAmountAt(data.tuitionInput.groups, 8)
          + tuitionGroupAmountAt(data.tuitionInput.groups, 9) <= 10000000000
      );
    }

    match /teacherMonthlyInputs/{inputId} {
      allow read: if isAdmin()
        || (activeAccount()
          && account().role == 'teacher'
          && resource.data.teacherUid == request.auth.uid
          && resource.data.teacherId == account().teacherId);
      allow create, update: if isAdmin()
        || (activeAccount()
          && account().role == 'teacher'
          && inputId == request.resource.data.month + '_' + account().teacherId
          && request.resource.data.keys().hasOnly([
            'teacherId', 'teacherUid', 'month', 'employeeWorkHours',
            'businessHours', 'tuitionInput', 'submittedAt', 'updatedAt', 'updatedBy'
          ])
          && request.resource.data.teacherId == account().teacherId
          && request.resource.data.teacherUid == request.auth.uid
          && request.resource.data.month.matches('^[0-9]{4}-[0-9]{2}$')
          && request.resource.data.employeeWorkHours is number
          && request.resource.data.employeeWorkHours >= 0
          && request.resource.data.employeeWorkHours <= 744
          && request.resource.data.businessHours is map
          && request.resource.data.businessHours.size() <= 10
          && hasValidTuitionSubmission(request.resource.data)
          && request.resource.data.submittedAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid
          && monthIsEditable(request.resource.data.month));
      allow delete: if isAdmin() && monthHasNoApprovedPayroll(resource.data.month);
    }

    match /expenseReceipts/{receiptId} {
      allow get, list: if isAdmin()
        || (activeAccount()
          && account().role == 'teacher'
          && resource.data.teacherUid == request.auth.uid
          && resource.data.teacherId == account().teacherId);
      allow create: if activeAccount()
        && account().role == 'teacher'
        && hasValidExpenseReceipt(request.resource.data, receiptId)
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.teacherId == account().teacherId
        && request.resource.data.status == 'pending'
        && request.resource.data.treatment == 'pending'
        && request.resource.data.insuranceCovered == false
        && request.resource.data.submittedAt == request.time
        && request.resource.data.reviewedAt == null
        && request.resource.data.reviewedBy == null
        && request.resource.data.reviewNote == ''
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && monthIsEditable(request.resource.data.month);
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && hasValidExpenseReceipt(request.resource.data, receiptId)
        && request.resource.data.teacherId == resource.data.teacherId
        && request.resource.data.teacherUid == resource.data.teacherUid
        && request.resource.data.month == resource.data.month
        && request.resource.data.status in ['approved', 'rejected']
        && ((request.resource.data.status == 'approved'
            && request.resource.data.treatment in ['employee', 'business', 'other', 'exempt'])
          || (request.resource.data.status == 'rejected'
            && request.resource.data.treatment == 'pending'
            && request.resource.data.insuranceCovered == false))
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'treatment', 'insuranceCovered', 'reviewNote',
          'reviewedAt', 'reviewedBy', 'updatedAt', 'updatedBy'
        ])
        && monthIsEditable(resource.data.month);
      allow delete: if (activeAccount()
          && account().role == 'teacher'
          && resource.data.teacherUid == request.auth.uid
          && resource.data.teacherId == account().teacherId
          && resource.data.status == 'pending'
          && monthIsEditable(resource.data.month))
        || (isAdmin()
          && resource.data.status in ['pending', 'rejected']
          && monthHasNoApprovedPayroll(resource.data.month));
    }

    match /adminNotifications/{notificationId} {
      allow read: if isAdmin();
      allow create: if validTeacherWorkHoursNotification(notificationId)
        || validTeacherExpenseReceiptNotification(notificationId);
      allow update: if validTeacherWorkHoursNotification(notificationId)
        || (isAdmin()
          && resource.data.type in ['teacher_monthly_input_submitted', 'expense_receipt_submitted']
          && resource.data.status == 'unread'
          && request.resource.data.status == 'read'
          && request.resource.data.readAt == request.time
          && request.resource.data.readBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'readAt', 'readBy'
          ]));
      allow delete: if (isAdmin() && monthHasNoApprovedPayroll(resource.data.month))
        || (activeAccount()
          && account().role == 'teacher'
          && resource.data.type == 'expense_receipt_submitted'
          && notificationId == 'expense-receipt_' + resource.data.receiptId
          && resource.data.teacherUid == request.auth.uid
          && resource.data.teacherId == account().teacherId
          && !existsAfter(/databases/$(database)/documents/expenseReceipts/$(resource.data.receiptId)));
    }

    match /taxPolicies/{policyId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.version == policyId
        && request.resource.data.effectiveFrom is string
        && request.resource.data.status == 'published';
      allow update, delete: if false;
    }

    match /insurancePolicies/{policyId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.version == policyId
        && request.resource.data.effectiveFrom is string;
      allow update, delete: if false;
    }

    match /payrollOverrides/{overrideId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && excludesResidentRegistrationNumber(request.resource.data);
      allow delete: if isAdmin() && monthHasNoApprovedPayroll(resource.data.month);
    }

    match /payrollRuns/{month} {
      allow read: if isAdmin() || hasRole('teacher');
      allow create: if isAdmin()
        && request.resource.data.status in ['draft', 'ready', 'published']
        && (request.resource.data.status != 'published'
          || (request.resource.data.revision is int && request.resource.data.revision == 1));
      allow update: if isAdmin()
        && (
          (resource.data.status in ['draft', 'ready']
            && request.resource.data.status in ['draft', 'ready', 'published'])
          || (resource.data.status == 'published'
            && request.resource.data.status == 'cancelled'
            && request.resource.data.revision == resource.data.revision
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'revision', 'cancellationId', 'cancellationReason',
              'cancelledAt', 'updatedAt', 'updatedBy'
            ]))
          || (resource.data.status == 'cancelled'
            && request.resource.data.status == 'published'
            && request.resource.data.revision is int
            && request.resource.data.revision == resource.data.revision + 1)
        );
      allow delete: if false;
    }

    match /payslips/{payslipId} {
      allow get, list: if isAdmin()
        || (activeAccount()
          && account().role == 'teacher'
          && resource.data.teacherUid == request.auth.uid
          && resource.data.status == 'published');
      allow create: if isAdmin() && validPublishedPayslip();
      allow update: if isAdmin()
        && (
          (resource.data.status == 'published'
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'cancellationId', 'cancellationReason', 'cancelledAt',
              'updatedAt', 'updatedBy'
            ]))
          || (resource.data.status == 'cancelled'
            && validPublishedPayslip()
            && request.resource.data.revision == resource.data.revision + 1)
        );
      allow delete: if false;
    }

    match /payslipVersions/{versionId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validPublishedPayslip();
      allow update, delete: if false;
    }

    match /payrollCancellations/{cancellationId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.month is string
        && request.resource.data.revision is int
        && request.resource.data.revision >= 1
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 5
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /payslipReceipts/{receiptId} {
      allow get: if isAdmin()
        || (activeAccount()
          && account().role == 'teacher'
          && receiptId.matches('.*_' + request.auth.uid));
      allow list: if isAdmin()
        || (activeAccount()
          && account().role == 'teacher'
          && resource.data.teacherUid == request.auth.uid);
      allow create: if activeAccount()
        && account().role == 'teacher'
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.teacherId == account().teacherId
        && request.resource.data.revision is int
        && request.resource.data.viewedAt == request.time
        && request.resource.data.keys().hasOnly([
          'payslipId', 'teacherId', 'teacherUid', 'month', 'revision', 'viewedAt'
        ])
        && get(/databases/$(database)/documents/payslips/$(request.resource.data.payslipId)).data.teacherUid == request.auth.uid
        && get(/databases/$(database)/documents/payslips/$(request.resource.data.payslipId)).data.teacherId == request.resource.data.teacherId
        && get(/databases/$(database)/documents/payslips/$(request.resource.data.payslipId)).data.month == request.resource.data.month
        && get(/databases/$(database)/documents/payslips/$(request.resource.data.payslipId)).data.revision == request.resource.data.revision
        && get(/databases/$(database)/documents/payslips/$(request.resource.data.payslipId)).data.status == 'published';
      allow update, delete: if false;
    }

    match /payslipDeliveries/{deliveryId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'payslipId', 'teacherId', 'month', 'recipientEmail', 'channel',
          'gmailMessageId', 'revision', 'sentBy', 'sentAt'
        ])
        && request.resource.data.payslipId is string
        && request.resource.data.teacherId is string
        && request.resource.data.month is string
        && request.resource.data.revision is int
        && request.resource.data.recipientEmail is string
        && request.resource.data.channel in ['gmail_attachment', 'gmail_portal_notice']
        && request.resource.data.gmailMessageId is string
        && request.resource.data.sentBy == request.auth.uid
        && request.resource.data.sentAt == request.time
        && get(/databases/$(database)/documents/payslips/$(request.resource.data.payslipId)).data.teacherId == request.resource.data.teacherId
        && get(/databases/$(database)/documents/payslips/$(request.resource.data.payslipId)).data.month == request.resource.data.month
        && get(/databases/$(database)/documents/payslips/$(request.resource.data.payslipId)).data.revision == request.resource.data.revision
        && get(/databases/$(database)/documents/payslips/$(request.resource.data.payslipId)).data.status == 'published';
      allow update, delete: if false;
    }

    match /payrollLedgers/{ledgerId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
